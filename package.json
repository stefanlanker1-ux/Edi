{
  "name": "edi",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/edi",
    "build": "npm run build --workspaces --if-present",
    "site": "npm run build && node scripts/assemble-site.mjs",
    "test": "node scripts/check-architecture.mjs && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
